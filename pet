#!/usr/bin/env bash
# pet — start/stop/restart the session-pet from anywhere (macOS + Linux).
#   pet          start (or restart) the pet
#   pet stop     quit it (same as right-click → Quit)
#   pet status   is it running?
set -euo pipefail
LABEL="com.session-pet"
if [[ "$(uname -s)" == "Linux" ]]; then
  PROC="session-pet"
  BIN="$(cd "$(dirname "$0")" && pwd)/linux/face/target/release/session-pet"
  [[ -x "$BIN" ]] || BIN="$HOME/.local/bin/session-pet"
else
  PROC="SessionPet"
  BIN="$(cd "$(dirname "$0")" && pwd)/native/SessionPet"
fi
case "${1:-start}" in
  stop)   pkill -x "$PROC" 2>/dev/null && echo "pet stopped" || echo "pet was not running" ;;
  status) pgrep -x "$PROC" >/dev/null && echo "pet is running (pid $(pgrep -x "$PROC"))" \
                                      || echo "pet is not running" ;;
  start|restart|*)
    if [[ "$PROC" == "SessionPet" ]]; then
      launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null \
        || { nohup "$BIN" >/dev/null 2>&1 & disown; }
    else
      pkill -x "$PROC" 2>/dev/null || true
      nohup "$BIN" >/dev/null 2>&1 & disown
    fi
    sleep 1
    pgrep -x "$PROC" >/dev/null && echo "pet is on screen" || echo "failed to start — try ./install.sh"
    ;;
esac
